<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payment_status">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Customer Payment Status Report</h2>
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Customer:</strong> <span t-field="doc.partner_id.name"/><br/>
                                <strong>Phone:</strong> <span t-field="doc.partner_id.phone"/><br/>
                                <strong>Address:</strong> <span t-field="doc.partner_id.contact_address"/>
                            </div>
                            <div class="col-6 text-right">
                                <strong>As of Date:</strong> <span t-field="doc.date_to"/>
                            </div>
                        </div>
                        
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Reference</th>
                                    <th>Description</th>
                                    <th class="text-right">Debit</th>
                                    <th class="text-right">Credit</th>
                                    <th>Status</th>
                                    <th class="text-right">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines" t-value="doc._get_report_lines()"/>
                                <tr t-foreach="lines" t-as="line" t-att-style="'background-color:#ffefcc;' if line['highlight'] else ''">
                                    <td><span t-esc="line['date']"/></td>
                                    <td><span t-esc="line['reference']"/></td>
                                    <td><span t-esc="line['description']"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % line['debit']"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % line['credit']"/></td>
                                    <td><span t-esc="line['status']"/></td>
                                    <td class="text-right"><strong><span t-esc="'%.2f' % line['balance']"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>